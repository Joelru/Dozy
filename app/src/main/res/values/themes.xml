<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Dozy" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Dozy" parent="Base.Theme.Dozy" />

    <style name="Widget.AppCompat.TextView.Title" parent="Base.Theme.Dozy">
        <item name="android:fontFamily">@font/poppins_black</item>
        <item name="textAllCaps">true</item>
        <item name="android:textSize">35sp</item>
        <item name="android:textColor">@color/dark_blue</item>
    </style>

    <style name="Widget.AppCompat.TextView.Standard" parent="Base.Theme.Dozy">
        <item name="android:fontFamily">@font/poppins_black</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/strong_blue</item>

    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_animation</item>
        <item name="android:windowExitAnimation">@anim/slide_out_animation</item>
    </style>


    <style name="TextViewTitleDefault">
        //Texto para titulos generales
        <item name="android:textColor">#0D1C17</item>
        <item name="android:fontFamily">@font/lexend_bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextViewCard">
        //Texto para card de currentTask
        <item name="android:textColor">@color/dark_forest</item>
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="searchBarCurrent" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="backgroundTint">@color/soft_mint</item>
        <item name="navigationIconTint">@color/teal_green</item>
        <item name="android:textColor">@color/teal_green</item>
        <item name="fontFamily">@font/lexend_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">5dp</item>
        <item name="shapeAppearanceOverlay">@style/SearchBarShape</item>

    </style>

    <style name="SearchBarShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="buttonSelectCategory">
        <item name="cornerRadius">8dp</item>
        <item name="iconTint">@color/dark_forest</item>
        <item name="android:textColor">@color/dark_forest</item>
        <item name="backgroundTint">@color/soft_mint</item>

        <item name="iconGravity">end</item>

    </style>
</resources>